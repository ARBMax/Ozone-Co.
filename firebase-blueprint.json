{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores private user information and settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID from Firebase Auth" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "format": "uri", "description": "User's profile picture URL" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User's role in the system" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the profile was created" }
      },
      "required": ["uid", "email", "role"]
    },
    "AnalysisHistory": {
      "title": "Analysis History",
      "description": "Stores historical analysis reports for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner of the analysis" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the analysis was performed" },
        "report": { "type": "object", "description": "The full AnalysisReport JSON" }
      },
      "required": ["uid", "timestamp", "report"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile data"
    },
    "/analysis_history/{historyId}": {
      "schema": "AnalysisHistory",
      "description": "Historical analysis records"
    }
  }
}
